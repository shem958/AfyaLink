# Backend environment configuration
# Copy this file to .env and fill in your values.

# ── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=            # Full DSN (overrides individual fields below if set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cdp
DB_PASSWORD=cdp_secret
DB_NAME=chronic_disease

# ── Redis ─────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=cdp_redis_secret

# ── Server ────────────────────────────────────────
PORT=8080
GIN_MODE=debug           # debug | release

# ── JWT ───────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars

# ── SMS (Africa's Talking) ────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=              # Set to enable real SMS notifications

# ── Email (optional) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
